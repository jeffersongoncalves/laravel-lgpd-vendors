{
    "name": "jeffersongoncalves/laravel-lgpd-vendors",
    "description": "LGPD vendor register for Laravel: processors and controllers you share personal data with, risk tier, data processing agreement checklist, international transfer mechanism and periodic review.",
    "keywords": [
        "laravel",
        "lgpd",
        "vendors",
        "processors",
        "dpa",
        "data-processing-agreement",
        "international-transfer",
        "privacy",
        "anpd",
        "gdpr"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-lgpd-vendors",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0",
        "jeffersongoncalves/laravel-lgpd": "^1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LgpdVendors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LgpdVendors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LgpdVendors\\LgpdVendorsServiceProvider"
            ],
            "aliases": {
                "LgpdVendors": "JeffersonGoncalves\\LgpdVendors\\Facades\\LgpdVendors"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
